df19 = read.table("../Modules/Week 4/CH01PR19.txt",
header=FALSE, sep="",
col.names=c("y","x"))
lmFit19 = lm(y~x, data = df19)
anova(lmFit19)
f = 3.5878 / .3883
print(f)
#you can find SSE and SSR from lmFit19
anova(lmFit19)
SSE = 45.818
SSR = 3.588
#you can find SSE(R) from lmFit19_r when x= 1 (this is our reduced regression)
lmFit19_r = lm(formula = y ~ 1, data= df19)
anova(lmFit19_r)
# SSE(R) = 49.405
#rr = SSR / SSE
rr = 3.588/49.405
print(rr)
df_crimeRate = read.table("../Modules/Week 4/CH01PR28.txt",
header=FALSE, sep="",
col.names=c("cr","ed"))
lmFit1_28 = lm(cr~ed, data=df_crimeRate)
summary(lmFit1_28)
#here we are working with a t-sided t-test
#calculcate t-value
t = -170.58 / 41.57
print(t)
#calculate critical value
#our degrees of freedom is showing that you have about 84 observations minus 2 (estimating 2 unknown parameters - slope and intercept)
critical = qt(0.995, df = 82)
print(critical)

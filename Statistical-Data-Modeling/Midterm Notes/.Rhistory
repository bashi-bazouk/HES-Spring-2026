knitr::opts_chunk$set(echo = TRUE)
library(faraway)
# Load our data! Here we are loading a txt file so note the delim
# Assigning the data to a data frame object
# called df20 and then we want to name the columns
df20 = read.delim("../Modules/Week 3/CH01PR20.txt", header=FALSE, sep="")
colnames(df20) = c("y", "x")
#this is our estimated regression function
lmFit20 = lm(y~x, df20)
#lets look at our estimated regression function
summary(lmFit20)
#here we will plot our estimated regression function
plot(df20$x, df20$y, ylab="Minutes", xlab="Copiers")
#here is our best fit line on our regression. We can look at our outliers & decide if the relationship is linear.
abline(lmFit20)
#calculate your standard error
coef(summary(lmFit20))[, "Std. Error"]
#or you can show this with your summary
summary(lmFit20)
library(caret)
#we can use predict to check on the future values based on the previous data and with the help of the linear model. This will help tell us how our model is performing over time.
Predicted<-predict(lmFit20,df20)
#once you predict - you want to see a summary
#the defaultSummary() function in R is used to calculate
#and report standard performance metrics for regression models.
Model<-data.frame(obs = df20$y, pred=Predicted)
Model=defaultSummary(Model)
print(Model)
#from here we would expect you to look at the results and comment on your findings
# Load data
df20 = read.delim("../Modules/Week 3/CH01PR20.txt", header=FALSE, sep="")
colnames(df20) = c("y", "x")
# Create linear model from data
lmFit20 = lm(y~x, df20)
print(summary(lmFit20))
#Finding our t-distribution
#In this case we want to first get our degrees of freedom which we can see from our summary is: 43
#or we can use our anova function to find the same
anova(lmFit20)
#We can find our t-distribution with our degrees of freedom
tdist = qt(1-.10/2, 43)
print(tdist)
#Use a 90 Percent Confidence Interval
confint(lmFit20, level=.9)
#or you can write it all out without a function:
c(15.0352-1.6811*0.4831, 15.0352+1.6811*0.4831)
t = ( 15.0352 - 0 ) / .4831
print(t)
#Calculate the p-value
p = 1-pt(31.122,43)
print(p)

#install.packages("EnvStats")
library(EnvStats)
anovaPE(toluca.reg)
#Alternative  way of performing lack of fit
Reduced <- lm(workhrs ~ lotsize,data=toluca_data)
Full <- lm(workhrs ~ 0 + as.factor(lotsize),data = toluca_data)
anova(Reduced, Full)
library(MASS)
par(mfrow=c(1,1))
PlasmaLevel <- data.frame(X=c(1:20), Y=c(1:20), LogY=log(c(1:20)), lamda=c(1:20))
f<-lm(Y~X,data=PlasmaLevel)
boxcox(f,lambda=seq(-5,5,by=.1))
boxcox(f,lambda=seq(-1,1,by=.1))
boxcox(f,lambda=seq(-2,1,by=.05))
#actual value lambda
a=boxcox(f,lambda=seq(-5,5,by=.1))
lamda=a$x[which.max(a$y)]
lamda
f1<-lm(LogY~X,data=PlasmaLevel)
f2<-lm(Y^lamda~X,data=PlasmaLevel)
summary(f1)
summary(f2)
par(mfrow=c(1,1))
f3.4<-lm(Dataset_1.20$V1 ~ Dataset_1.20$V2)
plot(Dataset_1.20$V1 ~ Dataset_1.20$V2, main = "lowess")
abline(f3.4,col=1)
lines(lowess(Dataset_1.20$V1 ~ Dataset_1.20$V2,f=0.01), col = 2)
lines(lowess(Dataset_1.20$V1 ~ Dataset_1.20$V2,f=0.1), col = 3)
lines(lowess(Dataset_1.20$V1 ~ Dataset_1.20$V2,f=1/3), col = 4)
lines(lowess(Dataset_1.20$V1 ~ Dataset_1.20$V2,f=2/3), col = 5)
lines(lowess(Dataset_1.20$V1 ~ Dataset_1.20$V2, f=.2), col = 6)
lines(lowess(Dataset_1.20$V1 ~ Dataset_1.20$V2, f=1), col = 7)
#legend(5, 120, c(paste("f = ", c("0.01","0.1","1/3","2/3", ".2","1"))), lty = 1, col = 2:7)
legend(8.5, 50, c(paste("f = ", c("0.01","0.1","1/3","2/3", ".2","1"))), lty = 1, col = 2:7)
y=Dataset_1.20$V1
x=Dataset_1.20$V2
model <- loess(y ~ x, span = 0.75)
x_new <- seq(min(x), max(x), length.out = 200)
y_hat <- predict(model, newdata = data.frame(x = x_new))
plot(x, y)
lines(x_new, y_hat, col = "red", lwd = 2)
abline(f3.4)
plot(x, y,main="Linear Regression")
abline(f3.4)
#loading Prostate Data
load(url("https://raw.githubusercontent.com/cran/faraway/master/data/prostate.rda"))
head(prostate)
y=prostate$lpsa
x=prostate$lcavol
#loess Regression
modelLoess <- loess(y ~ x, span = 0.75)
x_new <- seq(min(x), max(x), length.out = 200)
y_hat <- predict(modelLoess, newdata = data.frame(x = x_new))
#linear regression
f4<-lm(y~x)
plot(x, y)
lines(x_new, y_hat, col = "red", lwd = 2)
abline(f4)
#Calculate model performance Stats
library(caret)
#performance of LOESS
#get the predicted values
PredictedLoess<-predict(modelLoess, newdata = data.frame(x))
#create a data frame with 2 columns actual and predicted values
ModelDataLoess<-data.frame(obs = y, pred=PredictedLoess)
#calculate performance statistics
outModelDataLoess<-defaultSummary(ModelDataLoess)
#performance of Regression
#get the predicted values
PredictedReg<-predict(f4, newdata = data.frame(x))
#create a data frame with 2 columns actual and predicted values
ModelDataReg<-data.frame(obs = y, pred=PredictedReg)
#calculate performance statistics
outModelDataReg<-defaultSummary(ModelDataReg)
out<-rbind(outModelDataLoess,outModelDataReg)
dimnames(out)[[1]]<-c("LOESS","Reg")
out

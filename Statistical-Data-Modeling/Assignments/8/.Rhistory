toluca_data <- read.csv("../Lectures/1/toluca_data.csv")
#we want two graphs on the same page
par(mfrow=c(1,2))
#type="l" will draw line
plot(toluca_data$workhrs, type="l", ylab="Lot Size")
#type="p" is the default option, will give you the scatter plot
plot(toluca_data$workhrs, type="p", ylab="Lot Size")
# fitting the regression model
toluca.reg <- lm(workhrs ~ lotsize,data=toluca_data)
# getting the summary regression output:
summary(toluca.reg)
#error vs. Xi plot
ei<-toluca.reg$residuals
plot(toluca_data$workhrs,ei, type="l", xlab="Lot Size",ylab="Residuals")
#abs(error) vs. Xi plot
plot(toluca_data$workhrs,abs(ei), type="l", xlab="Lot Size",ylab="Absolute Residuals")
# error^2 vs. Xi plot
plot(toluca_data$workhrs,ei^2, type="l", xlab="Lot Size",ylab="Squared Residuals")
# ei. vs predicted
plot(toluca.reg$fitted.values,ei, type="l", xlab="Lot Size",ylab="Residuals")
# ei. vs time sequence
plot(ei, type="l",ylab="Residuals")
# QQ PLOT (aka normal probability plot)
error.std = rstandard(toluca.reg)
qqnorm(error.std,ylab="Standardized Residuals",xlab="Normal Scores",main="Toluca Data")
qqline(error.std, col = "steelblue", lwd = 2)
#alternatively, you can QQ plot
par(mfrow=c(2,2))
plot(toluca.reg)
shapiro.test(toluca.reg$residuals)
Dataset_1.20 <- read.csv("../Lectures/3/Dataset_1_20.csv", header=FALSE)
f3.4<-lm(Dataset_1.20$V1 ~ Dataset_1.20$V2)
summary(f3.4)
par(mfrow=c(2,2))
plot(f3.4)
ei<-f3.4$residuals
summary(Dataset_1.20$V2)
#We will separate the data based on the median value, we first need to create a data frame with X,Y and errors.
pop1.20<-data.frame(cbind(Dataset_1.20$V1, Dataset_1.20$V2,ei))
p1<-pop1.20[pop1.20[,2]< 5,]
p2<-pop1.20[pop1.20[,2]>=5,]
#get the medians for each sample
M1<-summary(p1[,3])[3]
M2<-summary(p2[,3])[3]
#get the n for each sample
N1<-dim(p1)[1]
N2<-dim(p2)[1]
#calculate dij = abs(error - median.error)
d1<-abs(p1[,3]-M1)
d2<-abs(p2[,3]-M2)
#calculate the pooled variance
s2<-sqrt((var(d1)*(N1-1)+var(d2)*(N2-1))/(N1+N2-2))
#calcualte the t statistics and p value
Den<- s2*sqrt(1/N1+1/N2)
Num<- mean(d1)-mean(d2)
T= Num/Den
1-pt(T,N1+N2-2)
library(car)
group=I(pop1.20[,2]< 5)*1
leveneTest(ei, group, center=median)
library(car)
group=I(pop1.20[,2]< 5)*1
leveneTest(Dataset_1.20$V1, group, center=median)
#using the library
library(olsrr)
ols_test_breusch_pagan(f3.4)
#from the new model, get SSR.S
ei<-f3.4$residuals
ei2<-ei^2
g<-lm(ei2~Dataset_1.20$V2)
summary(g)
anova(g)
SSR.S=  15155
#from the original model get SSE
anova(f3.4)
SSE =  3416
#n is 45
n=45
Chi_Square=(SSR.S/2) / ((SSE/n)^2)
1-pchisq(Chi_Square,1)
